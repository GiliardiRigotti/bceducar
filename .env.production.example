# Modelo de .env para produção com docker-compose.prod.yml.
# Copie para .env e substitua todos os valores marcados com TROCAR.

APP_NAME="BC Educar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TROCAR.exemplo.gov.br
APP_TIMEZONE=America/Sao_Paulo
APP_TRACK_ERROR=false
APP_DEFAULT_HOST=TROCAR.exemplo.gov.br
# Gera URLs https atrás do proxy (Caddy).
ASSETS_SECURE=true

# Usados pelo Caddy para o certificado HTTPS (Let's Encrypt).
APP_DOMAIN=TROCAR.exemplo.gov.br
ACME_EMAIL=TROCAR@exemplo.gov.br

API_ACCESS_KEY=
API_SECRET_KEY=

LEGACY_CODE=true
LEGACY_DISPLAY_ERRORS=false
LEGACY_PATH=ieducar

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_FILE_PERMISSION=0640
TELESCOPE_ENABLED=false

# DB_HOST e REDIS_HOST são definidos pelo docker-compose.prod.yml.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ieducar
DB_USERNAME=ieducar
DB_PASSWORD=TROCAR_SENHA_FORTE

BROADCAST_DRIVER=null
CACHE_STORE=redis
CACHE_TTL=604800
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

REDIS_HOST=redis
REDIS_CLIENT=predis
REDIS_PASSWORD=TROCAR_SENHA_FORTE
REDIS_PORT=6379
REDIS_PREFIX=ieducar-

# SMTP institucional ou provedor transacional (SPF/DKIM configurados no domínio).
MAIL_MAILER=smtp
MAIL_HOST=TROCAR
MAIL_PORT=587
MAIL_USERNAME=TROCAR
MAIL_PASSWORD=TROCAR
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@TROCAR.exemplo.gov.br
MAIL_FROM_NAME="BC Educar"

HONEYBADGER_API_KEY=
GOOGLE_TAG_MANAGER=

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

HOST_UID=1001
HOST_GID=1001

# Ajuste do PostgreSQL (padrão para 8 GB de RAM; para 16 GB use 4GB e 10GB).
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=5GB

# Pré-Matrícula Digital (servida a partir do build publicado).
FRONTIER_ENDPOINT=/pre-matricula-digital
FRONTIER_VIEWS_PATH=packages/portabilis/pre-matricula-digital/dist

# Mapas: o servidor público do OpenStreetMap não é destinado a uso em produção;
# use um provedor de tiles contratado ou servidor próprio.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
MAP_MAX_ZOOM=19
GEOCODING_URL=
GEOCODING_USER_AGENT=BC-Educar/1.0

BC_DOCUMENT_MAX_UPLOAD_KB=5120
BC_GUARDIAN_NOTIFICATIONS_ENABLED=false
BC_GUARDIAN_MESSAGES_ENABLED=false
BC_GUARDIAN_MESSAGES_START_AT=
BC_GUARDIAN_MESSAGES_COUNTRY_CODE=55
BC_SMS_ENABLED=false
BC_SMS_WEBHOOK_URL=
BC_SMS_WEBHOOK_TOKEN=
BC_WHATSAPP_ENABLED=false
BC_WHATSAPP_WEBHOOK_URL=
BC_WHATSAPP_WEBHOOK_TOKEN=
BC_DOCUMENT_RETENTION_DAYS=
BC_DOCUMENT_RETENTION_APPROVED=false
BC_DOCUMENT_RETENTION_POLICY_REFERENCE=
